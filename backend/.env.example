PORT=3002
DB_PATH=./data/chairmans-office.sqlite
FRONTEND_ORIGIN=http://localhost:5173
# Optional real AI; otherwise a substantial deterministic engine is used.
AI_ORDER=groq,gemini,zai,openrouter,openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-air
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional Web Push: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com
# 45 seconds for development; autonomous world time advances more slowly.
SCHEDULER_POLL_MS=45000
WORLD_STEP_MINUTES=45
ENABLE_DEV_CONTROLS=true
