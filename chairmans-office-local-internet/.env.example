# Copy to .env locally, but NEVER commit .env to GitHub.
PORT=10000

# Vapi private API key; keep secret.
VAPI_API_KEY=

# Generated by `npm run create:assistant` or copied from Vapi dashboard.
VAPI_ASSISTANT_ID=

# VAPI's PHONE NUMBER ID for your imported Twilio number. NOT the Twilio SID.
VAPI_PHONE_NUMBER_ID=

# Your own Nigerian mobile number; E.164 format, e.g. +2348XXXXXXXXX (placeholder only).
TEST_DESTINATION_NUMBER=

# Generate a random 32-byte token; protect /admin routes.
# Example: openssl rand -hex 32
ADMIN_API_TOKEN=

# Optional voice ID. Start with the documented OpenAI default 'alloy';
# pick a suitable female voice in Vapi's Voice Library after first smoke test.
VAPI_VOICE_ID=alloy
